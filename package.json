{
  "name": "clinozy-infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone infrastructure provisioning tool (setup:infra) for the clinozy-be application repo.",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11.1.1"
  },
  "scripts": {
    "setup": "tsx src/setup.ts",
    "setup:infra": "tsx src/setup.ts",
    "setup:infra:init": "tsx src/setup.ts --init",
    "setup:infra:preview": "tsx src/setup.ts --preview",
    "setup:infra:plan": "tsx src/setup.ts --plan",
    "setup:infra:inspect": "tsx src/setup.ts --inspect",
    "setup:infra:doctor": "tsx src/setup.ts --doctor",
    "setup:infra:next": "tsx src/setup.ts --next",
    "setup:infra:example": "tsx src/setup.ts --example",
    "setup:infra:guide": "tsx src/setup.ts --guide",
    "setup:infra:vault": "tsx src/setup.ts --vault",
    "setup:infra:check": "tsx src/setup.ts --check",
    "setup:infra:status": "tsx src/setup.ts --status",
    "setup:infra:output": "tsx src/setup.ts --output",
    "setup:infra:frontend": "tsx src/setup.ts --frontend",
    "setup:infra:delete": "tsx src/setup.ts --delete",
    "setup:infra:reconstruct": "tsx src/setup.ts --reconstruct",
    "setup:infra:export-env": "tsx src/setup.ts --export-env",
    "setup:infra:export-env:fe": "tsx src/setup.ts --export-env-fe",
    "setup:infra:domain": "tsx src/railway/custom-domain.ts",
    "setup:domain": "tsx src/railway/custom-domain.ts",
    "tool:railway-deploy-image": "tsx src/railway/deploy-image.ts",
    "github:sync": "tsx src/github/sync.ts",
    "github:sync:dry-run": "tsx src/github/sync.ts --dry-run",
    "setup:github": "tsx src/github/sync.ts",
    "setup:github:check": "tsx src/github/sync.ts --check",
    "setup:github:dry-run": "tsx src/github/sync.ts --dry-run",
    "setup:github:status": "tsx src/github/github.ts --status",
    "validate:github-environments": "tsx src/github/environments.ts --check",
    "setup:retention-secrets": "tsx src/push-retention-secrets.ts",
    "setup:push-retention-secrets": "tsx src/push-retention-secrets.ts",
    "rebrand": "tsx src/identity/rebrand.ts",
    "identity:sync": "tsx src/identity/rebrand.ts --sync --apply",
    "validate:identity": "tsx src/identity/validate-identity.ts",
    "health": "./src/health-check.sh",
    "health:fix": "./src/health-check.sh --fix",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-iam": "^3.1073.0",
    "@aws-sdk/client-s3": "^3.1073.0",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "libsodium-wrappers": "^0.8.4",
    "ora": "^9.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^25.9.4",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
